MAPTILER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Base URL of kwits-api. This app talks to nothing else -- auth and all data go
# through kwits-api, which is the only thing that talks to Supabase.
#
# 10.0.2.2 is the Android emulator's alias for the host machine. It is not a real
# IP address, and it is not reachable from a physical device: inside the emulator
# "localhost" refers to the emulator itself, which is why the alias exists.
#
#   Android emulator:    http://10.0.2.2:8080
#   iOS simulator / web: http://localhost:8080
#   physical device:     http://<your-machine's-LAN-IP>:8080
API_BASE_URL=http://10.0.2.2:8080

# Runs the auth flow against an in-memory mock instead of kwits-api. Needed
# while /v1/auth/verify-otp and /v1/auth/resend-code do not exist yet.
# Seeded account: demo@kwits.com / Kwits1234, and every emailed code is 123456.
USE_MOCK_API=true
