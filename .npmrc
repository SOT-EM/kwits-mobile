# Optional peer deps are not auto-installed. expo-router lists
# react-native-gesture-handler as an optional peer; nothing in this app imports it,
# and its generated C++ object paths exceed the Windows 260-character limit, which
# hard-fails `expo run:android` on this repo path. Without this flag every
# `npm install` / `expo install` silently re-adds it and breaks the native build.
legacy-peer-deps=true
